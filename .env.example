# Environment Variables for backend/ (copy to backend/.env — pydantic-settings
# loads ".env" relative to the backend process's working directory).
# Every value below has a working default in code; you only need this file at
# all if you want to override one of them.

# --- Backend (backend/app/config/settings.py) ---
PROJECT_NAME="AI Talent Intelligence Platform"
ENVIRONMENT=development
DEBUG=false
# Comma-separated list is NOT supported by pydantic's default List[str] parsing from
# env — leave as "*" for local dev, or edit BACKEND_CORS_ORIGINS in settings.py directly
# for a real origin allowlist before deploying.
# BACKEND_CORS_ORIGINS=["*"]

# --- AI Engine (ai_engine/src/config/settings.py) ---
# Dataset paths below are only needed if you want them somewhere other than the
# repo's own datasets/ directory — app/core/ai_engine_bootstrap.py already pins
# these to absolute paths under the repo root for you.
# DATA_RAW_DIR=
# DATA_PROCESSED_DIR=
# DATA_EMBEDDINGS_DIR=
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
BATCH_SIZE=256
TOP_K_DENSE=5000
TOP_K_PRE_RANK=1000
TOP_K_FINAL=100
# Hybrid ranking weights — must sum to 1.0 (the ranker normalizes them if they don't).
WEIGHT_SEMANTIC=0.30
WEIGHT_SKILL=0.20
WEIGHT_EXPERIENCE=0.15
WEIGHT_CAREER=0.10
WEIGHT_EDUCATION=0.05
WEIGHT_BEHAVIORAL=0.10
WEIGHT_AVAILABILITY=0.05
WEIGHT_LOCATION=0.05

# --- Supabase (not used yet — wired up in implementation.md Phase 5) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
